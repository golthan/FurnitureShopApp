{
  "name": "furniture-shop-app",
  "version": "1.0.0",
  "private": true,
  "description": "Run the FurnitureShopApp backend and Android app from the project root.",
  "scripts": {
    "backend": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-backend.ps1",
